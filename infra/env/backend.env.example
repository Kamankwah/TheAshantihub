# Server-side backend/.env — the real file is NOT in git and never should be.
#
# Copy to <checkout>/backend/.env on the server, fill in the secrets, then
# restart the stack. docker-compose.yml feeds this same file to both the app
# and the database container, so POSTGRES_* cannot drift between them.

# ── Core ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing this invalidates every signed-in session (JWTs stop verifying).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Encrypts staff 2-step sign-in secrets. REQUIRED — the app refuses to start
# without it when DJANGO_DEBUG=False. Set once; changing it locks every
# enrolled staffer out until each is reset with
# `manage.py reset_staff_two_factor <email>`. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STAFF_SECRETS_KEY=

# 127.0.0.1 and localhost are required, not optional: the container
# healthcheck probes the app over loopback and Django answers a Host header
# it does not recognise with a 400.
DJANGO_ALLOWED_HOSTS=api.theashantihub.com,127.0.0.1,localhost

# ── Database ────────────────────────────────────────────────────────────────
# POSTGRES_HOST is the compose service name, not localhost — from inside the
# app container "localhost" is the app container itself.
POSTGRES_DB=ashantihub
POSTGRES_USER=ashantihub
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── CORS ────────────────────────────────────────────────────────────────────
# The browser origins allowed to call this API. Must be exact origins
# (scheme + host, no trailing slash).
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_CORS_ALLOWED_ORIGINS=https://theashantihub.com,https://www.theashantihub.com

# ── Frontend ────────────────────────────────────────────────────────────────
# Used to build payment return URLs.
FRONTEND_BASE_URL=https://theashantihub.com

# ── Error reporting ─────────────────────────────────────────────────────────
# Sentry is the live alerting path. Leave blank to disable entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
DJANGO_LOG_LEVEL=INFO

# Recipients of Django's unhandled-exception mail. Inert until EMAIL_BACKEND
# below is a real SMTP backend — nothing is sent, and nothing errors.
DJANGO_ADMIN_EMAILS=
SERVER_EMAIL=no-reply@theashantihub.com

# ── Email ───────────────────────────────────────────────────────────────────
# NOT YET CONFIGURED. While this stays on the console backend, password
# resets and staff-invite emails are written to the container log and never
# delivered. Switch to SMTP before real users sign up:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@theashantihub.com

# ── Payments ────────────────────────────────────────────────────────────────
# Blank keeps every payment flow simulated (settings.PAYMENTS_PROVIDER).
# Setting HUBTEL_CLIENT_ID is what switches on real Hubtel checkout.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_WEBHOOK_SECRET=
HUBTEL_CALLBACK_URL=

# ── Subscriptions ───────────────────────────────────────────────────────────
# The subscription clock's pause. False (the default) keeps a business with an
# unpaid subscription visible: it is still marked overdue and reminded on days
# 7 and 13, but never paused or hidden. Turn on only when real payments (the
# planned in-app wallet) can renew automatically.
SUBSCRIPTION_PAUSE_ENABLED=False

# ── Live updates and background jobs ───────────────────────────────────────
# The redis container reads REDIS_PASSWORD; Django, the Celery worker and
# beat read REDIS_URL. Put the SAME password in both (env files don't
# substitute variables). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
REDIS_URL=redis://:PASTE_REDIS_PASSWORD_HERE@redis:6379/0
# True in production only: the nightly activity-log check emails its seal
# to every Super Admin. Staging only verifies.
ACTIVITY_SEAL_EMAIL=False

# ── Optional ────────────────────────────────────────────────────────────────
# Best-effort Ghana Post address validation during business registration.
GPS_REMOTE_VALIDATION=False
