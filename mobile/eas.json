{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-test.theashantihub.com"
      },
      "channel": "preview",
      "environment": "preview"
    },
    "play-internal": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-test.theashantihub.com"
      },
      "channel": "play-internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.theashantihub.com"
      },
      "ios": {},
      "channel": "production",
      "environment": "production"
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-test.theashantihub.com"
      },
      "channel": "testflight",
      "environment": "preview"
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {},
    "testflight": {
      "ios": {
        "ascAppId": "6831307433"
      }
    }
  }
}
