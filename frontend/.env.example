VITE_API_BASE_URL=http://localhost:8000
# Map tiles (optional). Leave empty for the default OpenStreetMap street tiles.
# A public, URL-restricted Mapbox token adds the satellite layer; never commit a real token.
VITE_MAP_TILES_PROVIDER=
VITE_MAPBOX_TOKEN=
# Browser error reporting (optional). Leave VITE_SENTRY_DSN empty to disable it entirely.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_RELEASE=
